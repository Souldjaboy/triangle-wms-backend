# ── Biométrie (visage, empreinte) — noyau biometrie/ ─────────────────────
# Clé de chiffrement des gabarits et des secrets d'appareils : 32 octets en
# hexadécimal (64 caractères), propre à chaque environnement, DIFFÉRENTE de
# JWT_SECRET. Sans elle, toute inscription biométrique est refusée (aucun
# repli). Rotation : BIOMETRIC_ENC_KEYS="k1:<hex>,k2:<hex>" + BIOMETRIC_ENC_KEY_ID=k2.
BIOMETRIC_ENC_KEY=
BIOMETRIC_ENC_KEYS=
BIOMETRIC_ENC_KEY_ID=
# Moteur de reconnaissance faciale LOCAL auto-hébergé (facultatif). Vide :
# le fournisseur « local » reste inactif. Aucun cloud biométrique.
FACE_ENGINE_URL=
FACE_ENGINE_TOKEN=
FACE_ENGINE_TIMEOUT_MS=8000
# Simulateur de tests : n'est accepté que si NODE_ENV=test. Jamais en production.
BIOMETRIC_ALLOW_MOCK=

# ── Passkeys (WebAuthn) ──────────────────────────────────────────────────
# Domaine exact servi aux navigateurs (sans schéma ni port) et origines
# autorisées, séparées par des virgules (https://…).
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGINS=
WEBAUTHN_RP_NAME=

# Les secrets des terminaux / agents biométriques ne sont PAS des variables :
# chaque appareil reçoit le sien à sa déclaration (affiché une fois, stocké
# chiffré). Limiteur de débit multi-instances : REDIS_URL (facultatif).
# Lectures de badge par minute et par IP (défaut 60).
ATTENDANCE_SCAN_RATE_LIMIT=
